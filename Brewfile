# macOS CLI workstation. GUI apps remain separate in README.md.
brew "git" # Distributed version control for source code.
brew "chezmoi" # Manage and apply dotfiles across machines.
brew "mise" # Manage project runtime versions, environments and tasks.
brew "gh" # Work with GitHub repositories, pull requests and issues from the terminal.

# System zsh + Zim. Zim loads these Homebrew plugins without downloading copies.
brew "zimfw" # Manage Zsh modules and generate their shell initialization.
brew "zsh-completions" # Additional completion definitions for Zsh.
brew "zsh-autosuggestions" # Suggest commands as you type based on shell history.
brew "zsh-syntax-highlighting" # Highlight commands and syntax in the Zsh command line.
brew "starship" # Customizable shell prompt with Git and runtime information.
brew "atuin" # Search shell history stored in a local database.
brew "fzf" # Interactively filter lists and select files with fuzzy matching.
brew "fd" # Find files and directories by name with concise syntax.
brew "ripgrep" # Search file contents recursively while respecting ignore files.
brew "zoxide" # Jump to frequently visited directories with z and zi.
brew "bat" # Display files with syntax highlighting and line numbers.
brew "eza" # List files with colors, tree views and Git status.
brew "less" # Read text one screen at a time and follow growing logs.
brew "tmux" # Run persistent terminal sessions with multiple windows and panes.
brew "neovim" # Edit text and source code in the terminal; provides nvim.
brew "lazygit" # Interactive terminal interface for Git.
brew "git-delta" # Display Git diffs with syntax highlighting; provides delta.

# Structured data, HTTP, databases and secrets.
brew "jq" # Query, filter and transform JSON.
brew "yq" # Query and transform YAML and other structured data.
brew "httpie" # Send HTTP requests with readable output; provides http and https.
brew "wget" # Download files over HTTP, HTTPS and FTP.
brew "openssl@3" # TLS and cryptographic tools, including certificate and digest commands.
brew "sqlite" # Embedded SQL database engine and sqlite3 command-line shell.
brew "sqlc" # Generate type-safe database access code from SQL queries.
brew "age" # Encrypt and decrypt files using recipient keys or passphrases.
brew "sops" # Edit encrypted configuration files using configured keys or key services.

# Monitoring, project dependencies, builds and automation.
brew "btop" # Interactively monitor CPU, memory, disks, network and processes.
brew "duf" # Show filesystem capacity and available disk space.
brew "dust" # Summarize disk usage by file and directory.
brew "procs" # List and filter processes with readable, colored output.
brew "watch" # Repeat a command at regular intervals and display its output.
brew "uv" # Manage Python dependencies, virtual environments and tools.
brew "cmake" # Configure projects and generate build files.
brew "ninja" # Run incremental builds from generated build files.
brew "pkgconf" # Look up library compiler and linker flags; provides pkg-config.
brew "make" # Run build rules and dependency-based tasks; GNU Make is gmake on macOS.
brew "tokei" # Count source lines, comments and blank lines by language.
brew "hyperfine" # Benchmark commands with repeated runs and statistical results.
brew "watchexec" # Run commands again when watched files change.
brew "just" # Run named project commands defined in a justfile.
