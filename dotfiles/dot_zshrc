# Interactive settings only. Standard commands keep their normal behavior.
[[ -o interactive ]] || return
typeset -U fpath
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_VERIFY EXTENDED_HISTORY
setopt INC_APPEND_HISTORY INTERACTIVE_COMMENTS
bindkey -e

if [[ -n "$HOMEBREW_PREFIX" ]]; then
    fpath=("$HOMEBREW_PREFIX/share/zsh-completions" "$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
fi
autoload -Uz compinit
compinit

(( $+commands[mise] )) && eval "$(mise activate zsh)"
if (( $+commands[uv] )); then
    eval "$(uv generate-shell-completion zsh)"
fi
if (( $+commands[uvx] )); then
    eval "$(uvx --generate-shell-completion zsh)"
fi
if (( $+commands[fzf] )); then
    # Disable fzf's history binding before initialization: Ctrl-R is Atuin's.
    export FZF_CTRL_R_COMMAND=''
    if (( $+commands[fd] )); then
        export FZF_CTRL_T_COMMAND='fd --type f --hidden --exclude .git'
        export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
    fi
    source <(fzf --zsh)
fi
(( $+commands[zoxide] )) && eval "$(zoxide init zsh --cmd z)"
(( $+commands[atuin] )) && eval "$(atuin init zsh --disable-up-arrow)"
(( $+commands[starship] )) && eval "$(starship init zsh)"

# Install/update modules explicitly with zimfw install/update, never at shell startup.
ZIM_HOME="$HOME/.zim"
zimfw() {
    local manager
    for manager in "${HOMEBREW_PREFIX}/opt/zimfw/share/zimfw.zsh" \
        "$ZIM_HOME/zimfw.zsh" /usr/share/zimfw/zimfw.zsh; do
        if [[ -r "$manager" ]]; then
            source "$manager" "$@"
            return $?
        fi
    done
    print -u2 'Install zimfw first; see README.md (Zim setup).'
    return 127
}
if [[ -r "$ZIM_HOME/init.zsh" ]]; then
    # fzf-tab follows compinit; autosuggestions and highlighting follow fzf-tab.
    source "$ZIM_HOME/init.zsh"
fi
