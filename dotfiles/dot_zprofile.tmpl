# Login environment; scripts and agents use mise exec with an explicit PATH.
typeset -U path PATH
{{ if eq .chezmoi.os "darwin" }}
export HOMEBREW_NO_ANALYTICS=1
# Apple's universal zsh can report MACHTYPE=x86_64 on native Apple Silicon.
if [[ "$(/usr/bin/uname -m)" == arm64 && -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv zsh)"
elif [[ "$(/usr/bin/uname -m)" == x86_64 && -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv zsh)"
fi
{{ end }}
path=("$HOME/.local/bin" "$HOME/go/bin" $path)
export PATH
